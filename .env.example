# SQLite for local development. For production switch provider to "postgresql" in prisma/schema.prisma
DATABASE_URL="file:./dev.db"
# Long random string used to sign login sessions
AUTH_SECRET="change-me-to-a-long-random-string"
# Secret key for /api/leads/inbound (Instagram / Telegram / website forms). Leave empty to disable.
LEADS_WEBHOOK_KEY=""
