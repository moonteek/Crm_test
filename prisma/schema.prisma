generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  // comma-separated permission keys, see src/lib/permissions.ts
  permissions String   @default("")
  // the built-in administrator role: always has every permission and can't be edited
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  users       User[]
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  phone     String     @unique
  password  String
  roleId    Int
  role      Role       @relation(fields: [roleId], references: [id])
  isTeacher Boolean    @default(false)
  // salesperson: can be assigned leads and gets KPI targets
  isSales   Boolean    @default(false)
  active    Boolean    @default(true)
  // salary rule: NONE | FIXED (so'm per month) | PERCENT (% of payments collected from own groups) | PER_STUDENT (so'm per active student)
  salaryType   String   @default("NONE")
  salaryAmount Int      @default(0)
  createdAt DateTime   @default(now())
  groups    Group[]    @relation("GroupTeacher")
  assistedGroups Group[] @relation("GroupAssistant")
  tokens    ApiToken[]
  salaryPayments SalaryPayment[]
  logs      AuditLog[]
  assignedLeads Lead[]  @relation("LeadAssignee")
  leadActivities LeadActivity[]
  kpiTargets KpiTarget[]
  sales     Sale[]
  membershipEvents MembershipEvent[]
  teachingHistory GroupTeacher[] @relation("TeachingHistory")
  slots     TeacherSlot[]
  studentNotes StudentNote[]
  discounts    Discount[]
  holidays     Holiday[]
  takenPayments Payment[]   @relation("PaymentTaker")
  paymentEdits  PaymentEdit[]
}

// Personal access tokens used by MCP clients. Only a SHA-256 hash is stored.
model ApiToken {
  id         Int       @id @default(autoincrement())
  name       String
  tokenHash  String    @unique
  prefix     String
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Course {
  id          Int      @id @default(autoincrement())
  name        String
  price       Int // oylik narx, so'm
  durationMon Int      @default(6)
  lessonMin   Int      @default(120)
  description String?
  createdAt   DateTime @default(now())
  groups      Group[]
  leads       Lead[]
  // a level exam is passed at this percentage of the maximum score
  passPercent Int      @default(60)
  subjects    Subject[]
}

/// One subject of a course, so many months (= levels) long, in course order (src/lib/curriculum.ts).
model Subject {
  id        Int      @id @default(autoincrement())
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name      String
  months    Int
  position  Int
  createdAt DateTime @default(now())
  startingGroups Group[]
}

model Room {
  id       Int     @id @default(autoincrement())
  name     String
  capacity Int     @default(15)
  groups   Group[]
}

model Group {
  id        Int               @id @default(autoincrement())
  name      String
  courseId  Int
  course    Course            @relation(fields: [courseId], references: [id])
  teacherId Int?
  teacher   User?             @relation("GroupTeacher", fields: [teacherId], references: [id])
  // optional support / assistant teacher
  assistantId Int?
  assistant User?             @relation("GroupAssistant", fields: [assistantId], references: [id])
  roomId    Int?
  room      Room?             @relation(fields: [roomId], references: [id])
  level     String? // one of GROUP_LEVELS in src/lib/format.ts
  // the group's own monthly price; empty = the course price (src/lib/billing.ts groupPrice)
  price     Int?
  days      String // "ODD" (Du-Chor-Ju) | "EVEN" (Se-Pay-Sha) | "DAILY"
  time      String // "14:00"
  startDate DateTime
  status    String            @default("ACTIVE") // ACTIVE | FINISHED
  createdAt DateTime          @default(now())
  students  GroupStudent[]
  attendance Attendance[]
  payments  Payment[]
  grades    Grade[]
  exams     Exam[]
  prices    GroupPrice[]
  teachers  GroupTeacher[]
  // where in the course the group began (empty = the first subject); levels count a month from startDate
  startSubjectId Int?
  startSubject   Subject? @relation(fields: [startSubjectId], references: [id], onDelete: SetNull)
  startLevel     Int      @default(1)
}

/// Who taught a group from a date on (TEACHER or ASSISTANT); lessons before keep the earlier person.
/// Groups with no rows use Group.teacherId / assistantId for every lesson (src/lib/teachers-history.ts).
model GroupTeacher {
  id        Int      @id @default(autoincrement())
  groupId   Int
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation("TeachingHistory", fields: [userId], references: [id], onDelete: SetNull)
  role      String // TEACHER | ASSISTANT
  from      DateTime // calendar date, UTC midnight
  createdAt DateTime @default(now())

  @@unique([groupId, role, from])
}

/// A group's monthly price from a month on (1st of the month, UTC); earlier months keep earlier rows.
/// Groups with no rows charge their current price (src/lib/prices.ts).
model GroupPrice {
  id        Int      @id @default(autoincrement())
  groupId   Int
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  price     Int
  from      DateTime
  userId    Int?
  createdAt DateTime @default(now())

  @@unique([groupId, from])
}

model Student {
  id        Int            @id @default(autoincrement())
  name      String
  phone     String
  parentPhone String?
  birthDate DateTime?
  note      String? // old single "Izoh"; moved into StudentNote by `npm run db:notes-from-izoh`
  // extra details ("+ qo'shimcha ma'lumot"), all optional
  gender     String? // M | F
  parentName String?
  phone2     String?
  school     String? // school and class, free text
  address    String?
  source     String? // one of LEAD_SOURCES
  passport   String? // only staff with students.manage see it; never exported
  createdAt DateTime       @default(now())
  tags      StudentTag[]
  notes     StudentNote[]
  auditLogs AuditLog[]
  groups    GroupStudent[]
  attendance Attendance[]
  payments  Payment[]
  grades    Grade[]
  examResults ExamResult[]
  leads     Lead[]
  purchases Sale[]
}

model GroupStudent {
  id        Int       @id @default(autoincrement())
  groupId   Int
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId Int
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  // TRIAL | ACTIVE | FROZEN | LEFT — the result of the last event; kept in sync by src/lib/membership-db.ts
  status    String    @default("ACTIVE")
  events    MembershipEvent[]

  @@unique([groupId, studentId])
  discounts Discount[]
}

/// One step in a student's life in a group; billing replays these (src/lib/billing.ts).
model MembershipEvent {
  id             Int          @id @default(autoincrement())
  groupStudentId Int
  groupStudent   GroupStudent @relation(fields: [groupStudentId], references: [id], onDelete: Cascade)
  type           String // TRIAL | ACTIVATE | FREEZE | UNFREEZE | BACK_TO_TRIAL | LEAVE
  date           DateTime // calendar date, UTC midnight
  reasonId       Int?
  reason         Reason?      @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  comment        String?
  userId         Int?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  // copied from before statuses existed; only months with nothing but migrated history keep the full-month rule
  migrated       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([groupStudentId, date])
}

/// Why a student froze or left a group; managed in Settings → Sabablar.
model Reason {
  id        Int               @id @default(autoincrement())
  name      String
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  events    MembershipEvent[]
}

model Attendance {
  id        Int      @id @default(autoincrement())
  groupId   Int
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  present   Boolean

  @@unique([groupId, studentId, date])
}

model Payment {
  id        Int      @id @default(autoincrement())
  studentId Int
  // Restrict: payments are financial history, so a student who has paid can't be deleted.
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  groupId   Int?
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  amount    Int
  method    String   @default("CASH") // CASH | CARD | TRANSFER
  note      String?
  date      DateTime @default(now())
  // who took it ("Hodim"); empty for payments from before this was recorded
  userId    Int?
  user      User?    @relation("PaymentTaker", fields: [userId], references: [id], onDelete: SetNull)
  // "Qaysi oy uchun": a label only (UTC 1st) — the balance doesn't depend on it
  month     DateTime?
  createdAt DateTime @default(now())
  edits     PaymentEdit[]
}

// One edit of a payment: what it was and what it became (JSON), and who changed it.
model PaymentEdit {
  id        Int      @id @default(autoincrement())
  paymentId Int
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  before    String
  after     String
  createdAt DateTime @default(now())

  @@index([paymentId])
}

model Expense {
  id       Int      @id @default(autoincrement())
  title    String
  category String   @default("OTHER") // SALARY | RENT | MARKETING | UTILITIES | OTHER
  amount   Int
  date     DateTime @default(now())
  salaryPayment SalaryPayment?
}

// Lesson grade on a 5-point scale.
model Grade {
  id        Int      @id @default(autoincrement())
  groupId   Int
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  score     Int

  @@unique([groupId, studentId, date])
}

model Exam {
  id       Int          @id @default(autoincrement())
  groupId  Int
  group    Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title    String
  date     DateTime
  maxScore Int          @default(100)
  // course month number for automatic level exams (src/lib/curriculum.ts levelExams); empty for exams added by hand
  level    Int?
  results  ExamResult[]

  @@unique([groupId, level])
}

model ExamResult {
  id        Int     @id @default(autoincrement())
  examId    Int
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score     Int

  @@unique([examId, studentId])
}

// A salary payout. Each one also records a SALARY expense so finance totals stay complete.
model SalaryPayment {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String // YYYY-MM the payout is for
  amount    Int
  note      String?
  date      DateTime @default(now())
  expenseId Int?     @unique
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // e.g. payment.create
  summary   String // human readable, Uzbek
  // the student it was about, for the student's history tab
  studentId Int?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([studentId])
}

// status: NEW | CONTACTED | TRIAL | WON | LOST
model Lead {
  id           Int       @id @default(autoincrement())
  name         String
  phone        String
  source       String? // Instagram, Telegram, Tanish, ...
  courseId     Int?
  course       Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  status       String    @default("NEW")
  note         String?
  assignedToId Int?
  assignedTo   User?     @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  nextActionAt DateTime? // follow-up reminder
  lostReason   String?
  wonAt        DateTime?
  studentId    Int? // student created from this lead
  student      Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  activities   LeadActivity[]
}

// Contact history: CALL | MESSAGE | MEETING | NOTE, and STATUS for status changes.
model LeadActivity {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  result    String? // for calls: ANSWERED | NO_ANSWER | BUSY ; for STATUS: the new status
  text      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Monthly KPI target for a salesperson. metric: WON | REVENUE | TRIALS | CALLS | CONVERSION
model KpiTarget {
  id       Int    @id @default(autoincrement())
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  month    String // YYYY-MM
  metric   String
  target   Int
  bonus    Int // paid once the target is reached
  perExtra Int    @default(0) // extra bonus per unit above the target

  @@unique([userId, month, metric])
}

// Books, merch and other goods sold to students.
model Product {
  id        Int        @id @default(autoincrement())
  name      String
  category  String     @default("MERCH") // BOOK | MERCH | OTHER
  price     Int
  cost      Int        @default(0) // purchase price per unit, for margin
  stock     Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  items     SaleItem[]
  moves     StockMove[]
}

model Sale {
  id        Int        @id @default(autoincrement())
  studentId Int?
  student   Student?   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  buyerName String? // when the buyer is not a student
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  total     Int
  method    String     @default("CASH")
  date      DateTime   @default(now())
  items     SaleItem[]
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  price     Int // unit price at the time of sale
  cost      Int     @default(0) // unit cost at the time of sale
}

// Stock changes: IN (restock), OUT (sale), ADJUST (count correction)
model StockMove {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String
  qty       Int // signed
  note      String?
  createdAt DateTime @default(now())
}

// A teacher's own weekly mark for one hour (08–20) on odd or even days. No row = not set.
// Lesson hours are never stored: they come from the active groups (src/lib/availability.ts).
model TeacherSlot {
  id      Int     @id @default(autoincrement())
  userId  Int
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayType String // ODD | EVEN
  hour    Int // 8..19 — the cell hour:00–hour+1:00
  free    Boolean // true = bo'sh, false = band

  @@unique([userId, dayType, hour])
}

// Labels admins (students.tags) keep in Settings → Teglar; staff attach them to students.
model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  color    String // one of TAG_COLORS
  active   Boolean      @default(true)
  students StudentTag[]
}

model StudentTag {
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tagId     Int
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([studentId, tagId])
}

// "Eslatma": notes about a student; at most one pinned (shown on the profile card).
model StudentNote {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  text      String
  pinned    Boolean  @default(false)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([studentId])
}

// "Chegirma": so'm off each month of [from, to] (UTC 1sts, inclusive) for one student in one group.
// Lowers the student's charge only; teacher pay keeps the full price (src/lib/billing.ts lessonValues).
model Discount {
  id             Int          @id @default(autoincrement())
  groupStudentId Int
  groupStudent   GroupStudent @relation(fields: [groupStudentId], references: [id], onDelete: Cascade)
  amount         Int
  from           DateTime
  to             DateTime
  reason         String?
  userId         Int?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([groupStudentId])
}

// "Bayram kunlari": a day the whole centre is closed (UTC midnight). Not charged, not paid, not a lesson.
model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique
  name      String
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}
